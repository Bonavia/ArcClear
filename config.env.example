# Copy this file to .env.local, then supply the connection URL privately.
# Public browser configuration. Use testnet or mainnet and the contract deployed on that network.
VITE_ARC_NETWORK=testnet
VITE_ARCCLEAR_CONTRACT_ADDRESS=0x8206202479c8f954c84126fe28289d148fd09393
# Never use a VITE_ prefix for database credentials.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Optional: download the Aiven project CA and enable verified TLS.
# DATABASE_CA_FILE=./ca.pem
# APP_ORIGIN=https://your-app.example
# API_HOST=127.0.0.1
# API_PORT=8787
